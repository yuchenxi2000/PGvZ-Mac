+			if (resolvedTarget == null || !string.Equals(Path.GetFullPath(resolvedTarget.FullName), Path.GetFullPath(targetPath), StringComparison.Ordinal))
+			{
+				Directory.Delete(linkPath);
+				Directory.CreateSymbolicLink(linkPath, targetPath);
+			}
+			return;
+		}
+		if (!Directory.Exists(linkPath) && !File.Exists(linkPath))
+		{
+			Directory.CreateSymbolicLink(linkPath, targetPath);
