/src/
/artifacts/
/dist/
**/bin/
**/obj/
*.app/
*.dSYM/

# Prevent accidental publication of game/runtime binaries
*.exe
*.dll
*.pdb
*.mdb
*.dylib
*.so
*.ico
*.bmp
